# systemd unit for the UserAlerts config web panel (useralerts_web.py).
#
# Installs the panel as a background service that starts on boot and
# restarts if it crashes, bound to localhost only -- nginx is what actually
# faces the internet (TLS + basic auth). Host/port/URL-path come from
# weewx.conf's [UserAlerts][[Web]] section (see useralerts_web.py's module
# docstring) -- this unit only needs to point at --config; after editing
# weewx.conf, generate the matching nginx block with gen_nginx_conf.py
# (next to this file) instead of hand-writing one.
#
# Install:
#   sudo cp useralerts-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now useralerts-web
#
# Adjust the paths below (User/Group, WorkingDirectory, ExecStart, --config)
# to match your actual install layout first. Everything here is host
# filesystem layout -- where the checkout/venv/weewx.conf actually live on
# *this* machine -- which weewx.conf has no way to express about itself, so
# unlike host/port/url_path above it can't be derived from it either; it has
# to be set once, here. As shipped, this assumes the Debian/apt `weewx`
# package's default layout:
#   - weewx.conf at /etc/weewx/weewx.conf, running as user/group "weewx"
#   - this repo checked out at /opt/weewx-alerts (adjust if you put it
#     somewhere else)
#   - a dedicated venv at /opt/weewx-alerts/web/venv, created with
#     --system-site-packages so it can still `import weecfg`/`weewx.*` from
#     the apt package's system Python install:
#       sudo python3 -m venv --system-site-packages /opt/weewx-alerts/web/venv
#       sudo /opt/weewx-alerts/web/venv/bin/pip install -r /opt/weewx-alerts/web/requirements.txt
#
# If WeeWX was instead installed via `pip` into its own venv (as in this
# dev repo), point WorkingDirectory/ExecStart/--config at that layout
# instead (e.g. /home/weewx/weewx-alerts, /home/weewx/venv,
# /home/weewx/weewx-data/weewx.conf) and skip the separate venv above --
# just reuse weewx's own venv, `pip install -r requirements.txt` into it.

[Unit]
Description=UserAlerts config web panel
Documentation=https://github.com/ladismrkolj/weewx-alerts
After=network.target

[Service]
Type=simple
User=weewx
Group=weewx
WorkingDirectory=/opt/weewx-alerts/web
ExecStart=/opt/weewx-alerts/web/venv/bin/python3 /opt/weewx-alerts/web/useralerts_web.py \
    --config /etc/weewx/weewx.conf
Restart=on-failure
RestartSec=5

# Light sandboxing. NOTE: no ProtectSystem= here -- on the apt package
# layout, WEEWX_ROOT is /etc/weewx, so users_dir (where this app writes
# per-user JSON) lives under /etc. ProtectSystem=full/strict would make
# /etc read-only and silently break every save. If you want that hardening,
# add ReadWritePaths= pointing at your actual users_dir, e.g.:
#   ProtectSystem=full
#   ReadWritePaths=/etc/weewx/user/useralerts
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
